<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EciSupportCentre.App.MainPage"
             Title="ECI Support Centre">

    <!-- Temporary page to check storage and sync on a device; replaced by the real screens in M3. -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="720">
            <Label Text="European Citizens' Initiatives"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="This app is under development. It is not an official app of the European Union."
                   FontSize="14"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="SyncButton"
                    Text="Sync now"
                    Clicked="OnSyncClicked"
                    SemanticProperties.Hint="Downloads the register and the news into the local database" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

            <Label x:Name="StatusLabel" FontSize="14" />

            <Label x:Name="OngoingLabel" FontSize="14" />

            <Button Text="Open the official website"
                    Clicked="OnOpenWebsiteClicked"
                    SemanticProperties.Hint="Opens citizens-initiative.europa.eu in the browser" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
