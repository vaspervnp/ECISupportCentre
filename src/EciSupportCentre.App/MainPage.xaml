<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EciSupportCentre.App.MainPage"
             Title="ECI Support Centre">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="640">
            <Label Text="European Citizens' Initiatives"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Follow every initiative, sign the ones you support and get notified when they end."
                   Style="{StaticResource SubHeadline}" />

            <Label Text="This app is under development. It is not an official app of the European Union."
                   FontSize="14"
                   HorizontalTextAlignment="Center" />

            <Button Text="Open the official website"
                    Clicked="OnOpenWebsiteClicked"
                    SemanticProperties.Hint="Opens citizens-initiative.europa.eu in the browser" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
