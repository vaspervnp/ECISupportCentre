<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EciSupportCentre.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Generate C# from XAML at compile time. -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- App identity -->
    <ApplicationTitle>ECI Support Centre</ApplicationTitle>
    <ApplicationId>io.github.vaspervnp.ecisupportcentre</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <!-- versionCode: must grow with every upload to Google Play. -->
    <ApplicationVersion>2</ApplicationVersion>

    <!-- Android 7.0 (API 24) and later -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Release signing for Google Play. Pass the keystore with -p:EciKeystore=path/to/upload.keystore -p:EciKeyAlias=upload
    and the password in the environment variable ECI_KEYSTORE_PASSWORD (never on the command line or in a file here).
    Without EciKeystore, Release builds are signed with the local debug key, which is fine for testing only.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(EciKeystore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(EciKeystore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(EciKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:ECI_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:ECI_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#003399" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#003399" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EciSupportCentre.Core\EciSupportCentre.Core.csproj" />
    <ProjectReference Include="..\EciSupportCentre.Data\EciSupportCentre.Data.csproj" />
  </ItemGroup>

</Project>
