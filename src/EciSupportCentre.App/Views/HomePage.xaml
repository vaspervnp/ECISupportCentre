<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EciSupportCentre.App.ViewModels"
             xmlns:views="clr-namespace:EciSupportCentre.App.Views"
             xmlns:l="clr-namespace:EciSupportCentre.App.Localization"
             x:Class="EciSupportCentre.App.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{l:Translate AppName}">

    <ContentPage.Resources>
        <Style x:Key="TileNumber" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </Style>
        <Style x:Key="TileLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardDark}}" />
        </Style>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="900">
                <Label Text="{l:Translate Home_Title}" Style="{StaticResource Headline}" HorizontalTextAlignment="Start"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{l:Translate Home_Intro}" FontSize="15" />

                <Label Text="{Binding SyncText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <!-- "Showing saved data" only makes sense once there is some; before that the empty card explains. -->
                <ContentView IsVisible="{Binding HasData}">
                    <views:StatusBanner />
                </ContentView>

                <!-- First start, before any data: what is happening, or how to get the data. -->
                <Border IsVisible="{Binding ShowEmptyState}" Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardDark}}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsDownloading}">
                            <ActivityIndicator IsRunning="{Binding IsDownloading}" HeightRequest="24" WidthRequest="24"
                                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Grid.Column="1" Text="{l:Translate Home_Downloading}" FontSize="15" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding CanDownload}">
                            <Label Text="{l:Translate Home_EmptyTitle}" FontFamily="OpenSansSemibold" FontSize="17"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding EmptyText}" FontSize="15" />
                            <Button Text="{l:Translate Home_Download}" Command="{Binding RefreshCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8"
                      IsVisible="{Binding HasData}">
                    <Border Style="{StaticResource Tile}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Registered}" Style="{StaticResource TileNumber}" />
                            <Label Text="{l:Translate Home_Registered}" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tile}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Collecting}" Style="{StaticResource TileNumber}" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                            <Label Text="{l:Translate Home_Collecting}" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Tile}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Successful}" Style="{StaticResource TileNumber}" />
                            <Label Text="{l:Translate Home_Successful}" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Answered}" Style="{StaticResource TileNumber}" />
                            <Label Text="{l:Translate Home_Answered}" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Tile}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Failed}" Style="{StaticResource TileNumber}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            <Label Text="{l:Translate Home_Failed}" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tile}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Withdrawn}" Style="{StaticResource TileNumber}" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                            <Label Text="{l:Translate Home_Withdrawn}" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{l:Translate Home_EndingSoon}" FontFamily="OpenSansSemibold" FontSize="18" Margin="0,8,0,0"
                       SemanticProperties.HeadingLevel="Level2" IsVisible="{Binding HasEndingSoon}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EndingSoon}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:InitiativeItemViewModel">
                            <views:InitiativeCard />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="{l:Translate Home_SeeAll}" Command="{Binding SeeAllCommand}" IsVisible="{Binding HasData}" />

                <views:SourceLink Page="Initiatives" />
                <Label Text="{l:Translate Disclaimer}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
