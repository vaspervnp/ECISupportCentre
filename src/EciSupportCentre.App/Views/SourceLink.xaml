<?xml version="1.0" encoding="utf-8" ?>
<!-- "Source: citizens-initiative.europa.eu/…", a tappable link to the official page the shown data comes from. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EciSupportCentre.App.Views.SourceLink">
    <Label x:Name="Text" FontSize="13" Padding="0,12" TextDecorations="Underline"
           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
        <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Label.GestureRecognizers>
    </Label>
</ContentView>
