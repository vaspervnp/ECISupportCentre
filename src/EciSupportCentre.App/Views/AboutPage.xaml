<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EciSupportCentre.App.ViewModels"
             xmlns:l="clr-namespace:EciSupportCentre.App.Localization"
             x:Class="EciSupportCentre.App.Views.AboutPage"
             x:DataType="vm:AboutViewModel"
             Title="{l:Translate Settings_About}">

    <ContentPage.Resources>
        <Style x:Key="SectionHeading" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="Body" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8" MaximumWidthRequest="720">
            <Label Text="{Binding VersionText}" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Start" HorizontalOptions="Start"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{l:Translate About_Intro}" Style="{StaticResource Body}" />
            <Label Text="{l:Translate About_CreatedBy}" FontFamily="OpenSansSemibold" FontSize="15" />

            <Label Text="{l:Translate About_NotOfficial}" Style="{StaticResource SectionHeading}" />
            <Label Text="{l:Translate About_NotOfficialText}" Style="{StaticResource Body}" />

            <Label Text="{l:Translate About_Sources}" Style="{StaticResource SectionHeading}" />
            <Label Text="{l:Translate About_SourcesText}" Style="{StaticResource Body}" />
            <Button Text="{l:Translate About_Website}" Command="{Binding OpenWebsiteCommand}" Style="{StaticResource Link}" />

            <Label Text="{l:Translate About_Privacy}" Style="{StaticResource SectionHeading}" />
            <Label Text="{l:Translate About_PrivacyText}" Style="{StaticResource Body}" />

            <Label Text="{l:Translate About_Licence}" Style="{StaticResource SectionHeading}" />
            <Label Text="{l:Translate About_LicenceText}" Style="{StaticResource Body}" />
            <Button Text="{l:Translate About_SourceCode}" Command="{Binding OpenSourceCodeCommand}" Style="{StaticResource Link}" />

            <Label Text="{l:Translate About_Translations}" Style="{StaticResource SectionHeading}" />
            <Label Text="{l:Translate About_TranslationsText}" Style="{StaticResource Body}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
