<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EciSupportCentre.App.ViewModels"
             xmlns:l="clr-namespace:EciSupportCentre.App.Localization"
             xmlns:views="clr-namespace:EciSupportCentre.App.Views"
             x:Class="EciSupportCentre.App.Views.NewsPage"
             x:DataType="vm:NewsViewModel"
             Title="{l:Translate Tab_News}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" Padding="16,0">
            <CollectionView x:Name="List" ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="8" Padding="0,16,0,8">
                        <Label Text="{l:Translate News_Title}" Style="{StaticResource Headline}"
                               HorizontalTextAlignment="Start" HorizontalOptions="Start"
                               SemanticProperties.HeadingLevel="Level1" />
                        <views:StatusBanner />
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="{l:Translate News_Empty}" Margin="0,24" HorizontalTextAlignment="Center"
                           x:DataType="vm:NewsViewModel" IsVisible="{Binding IsEmpty}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewsItemViewModel">
                        <Border Padding="12"
                                Margin="0,4"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 12"
                                SemanticProperties.Description="{Binding Title}"
                                SemanticProperties.Hint="{l:Translate News_OpenHint}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="72,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Border Grid.RowSpan="3"
                                        WidthRequest="72" HeightRequest="72"
                                        VerticalOptions="Start"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}">
                                    <Image Source="{Binding Image}" Aspect="AspectFill" IsVisible="{Binding HasImage}"
                                           AutomationProperties.IsInAccessibleTree="False" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />

                                <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="8">
                                    <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            Padding="8,2" IsVisible="{Binding IsNew}" VerticalOptions="Center">
                                        <Label Text="{l:Translate News_New}" TextColor="White" FontSize="12" />
                                    </Border>
                                    <Label Text="{Binding DateText}" FontSize="13" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1" Grid.Row="2"
                                       Text="{Binding Summary}"
                                       IsVisible="{Binding HasSummary}"
                                       FontSize="14"
                                       MaxLines="4"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Margin="0,12,0,16">
                        <Label Text="{l:Translate News_Source}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <views:SourceLink Page="News" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
    </RefreshView>
</ContentPage>
